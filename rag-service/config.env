DEFAULT_VECTOR_WEIGHT=0.7
DEFAULT_KEYWORD_WEIGHT=0.3

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_SIZE=384

# Logging
LOG_LEVEL=INFO

